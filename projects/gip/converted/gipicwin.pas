Function  AllocaFinestra (     X:      Integer;
                               Y:      Integer;
                               NumCol: Byte;
                               NumRow: Byte;
                           Var P:      Pointer ): Boolean;
Var
    FinX: Integer;
    FinY: Integer;

Begin { AllocaFinestra }

AllocaFinestra := False;
FinX := X+33*NumCol+5;  { = 33*10+5 }
FinY := Y+33*NumRow+5;  { = 30+8+33 }
Size := ImageSize(X,Y,FinX+Shadow,FinY+Shadow);
If ((MemAvail > Size) And (Size > 0))
  Then
    Begin
    AllocaFinestra := True;
    GetMem(P, Size);
    WaitToWrite;
    HideMouse;
    GetImage(X,Y,FinX+Shadow,FinY+Shadow,P^);
    SetFillPattern(MyFill,cShadowIconWin);
    SetFillStyle(UserFill,cShadowIconWin);
    Bar(X++Shadow,Y+Shadow,FinX+Shadow,FinY+Shadow);
    SetFillStyle(SolidFill,cBkIconWin);
    Bar(X,Y,FinX,FinY);
    SetColor(cIconWinBord);
    Rectangle(X,Y,FinX,FinY);
    SetGHorRange(X,FinX);
    SetGVertRange(Y,FinY);
    ShowMouse;
    End
Else
  AllocaFinestra := False;
End; { AllocaFinestra }


Procedure RilasciaMemoria (     X:      Integer;
                                Y:      Integer;
                            Var P:      Pointer );
Begin { RilasciaMemoria }
WaitToWrite;
HideMouse;
PutImage(X,Y,P^,NormalPut);
ShowMouse;
FreeMem(P,Size);
SetGHorRange(0,GetMaxX);
SetGVertRange(0,GetMaxY);
End; { RilasciaMemoria }


